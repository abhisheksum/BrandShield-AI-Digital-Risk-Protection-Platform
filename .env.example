# Copy this file to .env, generate a private SECRET_KEY, and never commit .env.
SECRET_KEY=

# Frontend published port for docker compose.
WEB_PORT=8080

# Same-origin deployment uses Nginx, so no cross-origin browser access is needed.
CORS_ORIGINS=[]

# Apple iTunes Search API configuration (no API credentials required).
APPLE_STORE_COUNTRY=us
APPLE_STORE_RESULT_LIMIT=25
APPLE_STORE_TIMEOUT_SECONDS=6

# Auth lifetime and scoring settings.
ACCESS_TOKEN_EXPIRE_MINUTES=1440
WEIGHT_NAME_SIMILARITY=0.30
WEIGHT_LOGO_SIMILARITY=0.25
WEIGHT_DESCRIPTION_SIMILARITY=0.20
WEIGHT_PUBLISHER_MISMATCH=0.15
WEIGHT_SUSPICIOUS_BEHAVIOR=0.10
ALERT_RISK_THRESHOLD=40
MEDIUM_RISK_THRESHOLD=45
HIGH_RISK_THRESHOLD=65
CRITICAL_RISK_THRESHOLD=80
