# ==========================================
# BrandShield AI — Master Environment Config
# ==========================================

# Core Application Settings
PROJECT_NAME="BrandShield AI"
VERSION="1.0.0"
API_V1_STR="/api"

# Local SQLite Database
DATABASE_URL="sqlite:///./brandshield.db"

# CORS Configuration (comma-separated or JSON list)
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173"]'

# Risk Scoring Model Weights (must sum to 1.0)
WEIGHT_NAME_SIMILARITY=0.30
WEIGHT_LOGO_SIMILARITY=0.25
WEIGHT_DESCRIPTION_SIMILARITY=0.20
WEIGHT_PUBLISHER_MISMATCH=0.15
WEIGHT_SUSPICIOUS_BEHAVIOR=0.10

# Threat Alert Score Thresholds
ALERT_RISK_THRESHOLD=40.0
CRITICAL_RISK_THRESHOLD=80.0
HIGH_RISK_THRESHOLD=65.0
MEDIUM_RISK_THRESHOLD=45.0

# Frontend Configuration
VITE_API_URL="/api"
