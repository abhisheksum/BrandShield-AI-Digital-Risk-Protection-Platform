# Copy to .env for local backend settings. Set SECRET_KEY to a private value.
PROJECT_NAME="Rakshak — Digital Brand Protection"
VERSION=1.0.0
API_V1_STR=/api
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DATABASE_URL=sqlite:///./rakshak.db
UPLOAD_DIR=uploads
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'

APPLE_STORE_COUNTRY=us
APPLE_STORE_RESULT_LIMIT=25
APPLE_STORE_TIMEOUT_SECONDS=6

WEIGHT_NAME_SIMILARITY=0.30
WEIGHT_LOGO_SIMILARITY=0.25
WEIGHT_DESCRIPTION_SIMILARITY=0.20
WEIGHT_PUBLISHER_MISMATCH=0.15
WEIGHT_SUSPICIOUS_BEHAVIOR=0.10
ALERT_RISK_THRESHOLD=40
MEDIUM_RISK_THRESHOLD=45
HIGH_RISK_THRESHOLD=65
CRITICAL_RISK_THRESHOLD=80
